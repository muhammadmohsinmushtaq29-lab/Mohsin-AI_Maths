      <select id="formulaChoice">
        <option value="sumSquare">(a+b)²</option>
        <option value="differenceSquare">(a-b)²</option>
        <option value="differenceSquares">a²-b²</option>
        <option value="sumCube">(a+b)³</option>
        <option value="differenceCube">(a-b)³</option>
      </select>

      <label>a</label>
