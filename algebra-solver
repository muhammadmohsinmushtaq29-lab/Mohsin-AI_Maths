        Example: x² − 5x + 6 = (x − 2)(x − 3)
      </p>
    `;
  }

  else if(type === "power"){
    inputs.innerHTML = `
      <label>Base</label>
      <input id="base" type="number" placeholder="Example: 2">

      <label>Exponent</label>
      <input id="exponent" type="number" placeholder="Example: 5">
    `;
  }

  else if(type === "percentage"){
    inputs.innerHTML = `
