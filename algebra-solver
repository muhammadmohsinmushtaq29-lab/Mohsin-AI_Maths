/* ---------------- FORMULAS ---------------- */

function solveFormula(){

  const choice = document.getElementById("formulaChoice").value;
  const a = Number(document.getElementById("fa").value);
  const b = Number(document.getElementById("fb").value);

  if(!Number.isFinite(a) || !Number.isFinite(b)){
    showError("Enter values for a and b.");
    return;
  }

  let answer;
  let formula;

  if(choice === "sumSquare"){
    answer = Math.pow(a+b,2);
    formula = `(a+b)² = a² + 2ab + b²`;
  }

  else if(choice === "differenceSquare"){
    answer = Math.pow(a-b,2);
    formula = `(a-b)² = a² − 2ab + b²`;
  }

  else if(choice === "differenceSquares"){
    answer = Math.pow(a,2)-Math.pow(b,2);
    formula = `a² − b² = (a−b)(a+b)`;
  }

  else if(choice === "sumCube"){
    answer = Math.pow(a+b,3);
    formula = `(a+b)³ = a³ + 3a²b + 3ab² + b³`;
  }

  else{
    answer = Math.pow(a-b,3);
    formula = `(a-b)³ = a³ − 3a²b + 3ab² − b³`;
  }

  showSolution(
    `<strong>${formatNumber(answer)}</strong>`,
    [
      `Formula: ${formula}`,
      `a = ${a}, b = ${b}`,
      `Substitute the values into the formula.`,
      `Final answer = ${formatNumber(answer)}`
    ]
  );
}

