        <div class="step">
          <strong>Step ${i+1}</strong><br>
          ${s}
        </div>
      `).join("")}
    </div>
  `;
}

function solve(){

  const type = document.getElementById("type").value;

  try{

    if(type === "linear"){
      solveLinear();
    }

    else if(type === "quadratic"){
      solveQuadratic();
    }

    else if(type === "simultaneous"){
      solveSimultaneous();
    }

    else if(type === "simplify"){
      solveSimplify();
    }

    else if(type === "factor"){
      solveFactor();
    }

    else if(type === "power"){
      solvePower();
    }

    else if(type === "percentage"){
      solvePercentage();
    }

    else if(type === "formula"){
      solveFormula();
    }

  }catch(error){
    showError("Please enter valid values.");
  }
}

/* ---------------- LINEAR ---------------- */

function solveLinear(){

  let eq = document.getElementById("eq1").value.trim();

  if(!eq){
    showError("Please enter an equation.");
    return;
  }

  eq = eq.replace(/\s/g,"");

  const parts = eq.split("=");

  if(parts.length !== 2){
    showError("Use an equation like 2x+5=15.");
    return;
  }

  let left = parts[0];
  let right = parts[1];

  const coefficient = getCoefficient(left);
  const constantLeft = getConstant(left);
  const rightValue = evaluateNumber(right);

  if(coefficient === null || rightValue === null){
    showError("Please use a simple linear equation such as 2x+5=15.");
    return;
  }

  const x = (rightValue - constantLeft) / coefficient;

  showSolution(
    `x = <strong>${formatNumber(x)}</strong>`,
    [
      `Original equation: ${eq}`,
      `Move the constant: ${formatNumber(coefficient)}x = ${formatNumber(rightValue - constantLeft)}`,
      `Divide by ${formatNumber(coefficient)}: x = ${formatNumber(x)}`
    ]
  );
}

function getCoefficient(expr){

  let match = expr.match(/([+-]?\d*\.?\d*)x/i);

  if(!match) return null;

  let value = match[1];

  if(value === "" || value === "+") return 1;
  if(value === "-") return -1;

  return Number(value);
}

function getConstant(expr){

  let withoutX = expr.replace(/([+-]?\d*\.?\d*)x/ig,"");

  if(withoutX === "" || withoutX === "+") return 0;

  return Number(withoutX);
}

function evaluateNumber(value){

  if(!/^[+-]?\d*\.?\d+$/.test(value)) return null;

  return Number(value);
}

/* ---------------- QUADRATIC ---------------- */

function solveQuadratic(){

  const a = Number(document.getElementById("a").value);
  const b = Number(document.getElementById("b").value);
  const c = Number(document.getElementById("c").value);

  if(!Number.isFinite(a) || !Number.isFinite(b) || !Number.isFinite(c)){
    showError("Please enter a, b and c.");
    return;
  }

  if(a === 0){
    showError("Coefficient a cannot be 0 for a quadratic equation.");
    return;
  }

  const d = b*b - 4*a*c;

  if(d > 0){

    const x1 = (-b + Math.sqrt(d))/(2*a);
    const x2 = (-b - Math.sqrt(d))/(2*a);

    showSolution(
      `x₁ = <strong>${formatNumber(x1)}</strong><br>
       x₂ = <strong>${formatNumber(x2)}</strong>`,
      [
        `Equation: ${a}x² + ${b}x + ${c} = 0`,
        `Discriminant: Δ = b² − 4ac = ${formatNumber(d)}`,
        `x = (−b ± √Δ) / 2a`,
        `x₁ = ${formatNumber(x1)}, x₂ = ${formatNumber(x2)}`
      ]
    );

  }else if(d === 0){

    const x = -b/(2*a);

    showSolution(
      `x = <strong>${formatNumber(x)}</strong>`,
      [
        `Equation: ${a}x² + ${b}x + ${c} = 0`,
        `Discriminant: Δ = 0`,
        `x = −b / 2a`,
        `x = ${formatNumber(x)}`
      ]
    );

  }else{

    const real = -b/(2*a);
    const imaginary = Math.sqrt(-d)/(2*a);

    showSolution(
      `x₁ = ${formatNumber(real)} + ${formatNumber(Math.abs(imaginary))}i<br>
       x₂ = ${formatNumber(real)} − ${formatNumber(Math.abs(imaginary))}i`,
      [
        `Discriminant: Δ = ${formatNumber(d)}`,
        `Because Δ < 0, there are no real solutions.`,
        `The solutions are complex numbers.`
      ]
    );
  }
}

/* ---------------- SIMULTANEOUS ---------------- */

function parseEquationXY(eq){

  eq = eq.replace(/\s/g,"");

  const parts = eq.split("=");

  if(parts.length !== 2) return null;

  const left = parts[0];
  const right = Number(parts[1]);

  if(!Number.isFinite(right)) return null;

  const xMatch = left.match(/([+-]?\d*\.?\d*)x/i);
  const yMatch = left.match(/([+-]?\d*\.?\d*)y/i);

  let A = 0;
  let B = 0;

  if(xMatch){
    A = xMatch[1] === "" || xMatch[1] === "+" ?
      1 :
      xMatch[1] === "-" ? -1 : Number(xMatch[1]);
  }

  if(yMatch){
    B = yMatch[1] === "" || yMatch[1] === "+" ?
      1 :
      yMatch[1] === "-" ? -1 : Number(yMatch[1]);
  }

  return {A,B,C:right};
}

function solveSimultaneous(){

  const eq1 = parseEquationXY(document.getElementById("eq1").value);
  const eq2 = parseEquationXY(document.getElementById("eq2").value);

  if(!eq1 || !eq2){
    showError("Use equations like 2x+y=7 and x-y=1.");
    return;
  }

  const determinant = eq1.A*eq2.B - eq2.A*eq1.B;

  if(determinant === 0){
    showError("The equations do not have one unique solution.");
    return;
  }

  const x = (eq1.C*eq2.B - eq2.C*eq1.B)/determinant;
  const y = (eq1.A*eq2.C - eq2.A*eq1.C)/determinant;

  showSolution(
    `x = <strong>${formatNumber(x)}</strong><br>
     y = <strong>${formatNumber(y)}</strong>`,
    [
      `Equation 1: ${eq1.A}x + ${eq1.B}y = ${eq1.C}`,
      `Equation 2: ${eq2.A}x + ${eq2.B}y = ${eq2.C}`,
      `Use elimination/Cramer's rule.`,
      `x = ${formatNumber(x)}`,
      `y = ${formatNumber(y)}`
    ]
  );
}

/* ---------------- SIMPLIFY ---------------- */

function solveSimplify(){

  const expr = document.getElementById("expression").value.trim();

  if(!expr){
    showError("Enter an algebraic expression.");
    return;
  }

  const normalized = expr
    .replace(/\s/g,"")
    .replace(/−/g,"-");

  const terms = normalized.match(/[+-]?[^+-]+/g);

  if(!terms){
    showError("Invalid expression.");
    return;
  }

  let xCoefficient = 0;
  let constant = 0;
  let valid = true;

  terms.forEach(term => {

    if(/x/i.test(term)){

      let coefficient = term
        .replace(/x/ig,"");

      if(coefficient === "" || coefficient === "+")
        coefficient = 1;
      else if(coefficient === "-")
        coefficient = -1;
      else
        coefficient = Number(coefficient);

      if(!Number.isFinite(coefficient))
        valid = false;
      else
        xCoefficient += coefficient;

    }else{

      const n = Number(term);

      if(!Number.isFinite(n))
        valid = false;
      else
        constant += n;
    }
  });

  if(!valid){
    showError("This simple solver supports expressions such as 2x+3x-5.");
    return;
  }

  let answer = "";

  if(xCoefficient !== 0)
    answer += `${formatNumber(xCoefficient)}x`;

  if(constant !== 0){
    if(answer && constant > 0) answer += " + ";
    else if(answer && constant < 0) answer += " − ";
    else if(constant < 0) answer += "−";

    answer += formatNumber(Math.abs(constant));
  }

  if(answer === "") answer = "0";

  showSolution(
    `<strong>${answer}</strong>`,
    [
      `Original expression: ${expr}`,
      `Combine like x terms: ${formatNumber(xCoefficient)}x`,
      `Combine constants: ${formatNumber(constant)}`,
      `Simplified expression: ${answer}`
    ]
  );
}

/* ---------------- FACTORIZATION ---------------- */

function solveFactor(){

  let expr = document.getElementById("expression").value
    .replace(/\s/g,"")
    .replace(/−/g,"-");

  const match = expr.match(
    /^([+-]?\d*\.?\d*)x²([+-]\d*\.?\d*)x([+-]\d+\.?\d*)$/i
  );

  if(!match){
    showError("Use a quadratic such as x²-5x+6.");
    return;
  }

  let a = match[1];
  let b = match[2];
  let c = match[3];

  a = a === "" || a === "+" ? 1 :
      a === "-" ? -1 : Number(a);

  b = b === "" || b === "+" ? 1 :
      b === "-" ? -1 : Number(b);

  c = Number(c);

  if(a !== 1){
    showError("For this simple factorization tool, use a = 1.");
    return;
  }

  let factors = [];

  for(let i=-Math.abs(c); i<=Math.abs(c); i++){

    if(i === 0) continue;

    let j = c/i;

    if(Number.isInteger(j) && i+j === b){
      factors = [i,j];
      break;
    }
  }

  if(!factors.length){
    showSolution(
      "Cannot factor over integers.",
      [
        `Expression: ${expr}`,
        `No integer factor pair was found.`,
        `The quadratic may require the quadratic formula.`
      ]
    );
    return;
  }

  const [m,n] = factors;

  const f1 = m >= 0 ? `x + ${m}` : `x − ${Math.abs(m)}`;
  const f2 = n >= 0 ? `x + ${n}` : `x − ${Math.abs(n)}`;

  showSolution(
    `<strong>(${f1})(${f2})</strong>`,
    [
      `Original expression: ${expr}`,
      `Find two numbers whose product is ${c}.`,
      `Their sum must be ${b}.`,
      `The numbers are ${m} and ${n}.`,
      `Therefore: ${f1}${f2}`
    ]
  );
}

