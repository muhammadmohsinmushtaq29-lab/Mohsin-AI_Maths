}

function showError(message){
  result.innerHTML = `<div class="error">${message}</div>`;
}

function showSolution(answer, steps){

  result.innerHTML = `
    <div class="result-title">
      <h2>Solution</h2>
      <span class="badge">Solved</span>
    </div>

    <div class="answer-main">
